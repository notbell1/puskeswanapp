@startuml 09-class-diagram
title Class Diagram Konseptual - Sistem Informasi Puskeswan
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam classAttributeIconSize 0

enum RoleName {
  SUPER_ADMIN
  ADMIN
  DOKTER
}

class Role {
  +id : BigInteger
  +nama_role : RoleName
  +deskripsi : String
  --
  +aturHakAkses()
}

class Staf {
  +id : BigInteger
  +nama_staf : String
  +jabatan : String
  +nip_strv : String
  +foto : String
  --
  +kelolaDataStaf()
}

class User {
  +id : BigInteger
  +id_role : BigInteger
  +id_staf : BigInteger
  +name : String
  +email : String
  +password : String
  +foto : String
  +status_aktif : Boolean
  +two_factor_secret : String
  --
  +login()
  +logout()
  +autentikasiPasskey()
}

class Passkey {
  +id : BigInteger
  +user_id : BigInteger
  +name : String
  +credential_id : String
  +credential : JSON
  +last_used_at : DateTime
  --
  +verifikasiFIDO2()
}

class Pemilik {
  +id : BigInteger
  +nik : String <<unique, autofill>>
  +nama_lengkap : String
  +no_hp_wa : String
  +alamat_lengkap : String
  --
  +cariAtauAutofillPemilik()
  +kelolaDataPemilik()
}

class JenisHewan {
  +id : BigInteger
  +nama_jenis : String
  +keterangan : String
  --
  +pilihDariDropdown()
  +kelolaJenisHewan()
}

class Hewan {
  +id : BigInteger
  +id_pemilik : BigInteger
  +id_jenis_hewan : BigInteger
  +no_rm : String <<unique, format: RM0001>>
  +nama_hewan : String
  +jenis_kelamin : String
  +umur : String
  +warna_hewan : String
  --
  +buatNomorRMPermanen()
  +perbaruiDataHewan()
}

class Kunjungan {
  +id : BigInteger
  +id_hewan : BigInteger
  +id_admin : BigInteger
  +tgl_kunjungan : DateTime
  +berat_badan : Decimal
  +suhu_tubuh : Decimal
  +anamnesa : String
  +status_antrean : String <<Antri / Selesai>>
  --
  +daftarkanKunjunganAwal()
  +perbaruiStatusAntrean()
}

class Pemeriksaan {
  +id : BigInteger
  +id_kunjungan : BigInteger
  +id_dokter : BigInteger
  +waktu_selesai : DateTime
  +diagnosa : String
  +terapi_pengobatan : String
  +catatan : String
  --
  +catatHasilPemeriksaan()
  +simpanDanSelesaikan()
}

class Obat {
  +id : BigInteger
  +kode_obat : String
  +nama_obat : String
  +stok : Integer
  +satuan : String
  --
  +kelolaMasterObat()
  +penyesuaianStok()
}

class Inventaris {
  +id : BigInteger
  +id_pengelola : BigInteger
  +kode_barang : String
  +nama_barang : String
  +kategori : String
  +jumlah : Integer
  +kondisi : String
  +keterangan : String
  --
  +tambahInventaris()
  +perbaruiInventaris()
  +hapusInventaris()
}

class KategoriArtikel {
  +id : BigInteger
  +nama_kategori : String
  +slug : String
  --
  +tambahKategori()
  +ambilDaftarKategori()
}

class Artikel {
  +id : BigInteger
  +id_penulis : BigInteger
  +id_kategori : BigInteger
  +id_staf : BigInteger
  +judul : String
  +slug : String
  +author_name : String
  +ringkasan : String
  +isi_berita : String
  +gambar : String
  +tgl_terbit : Date
  +status : String <<draft / published>>
  --
  +buatArtikel()
  +perbaruiArtikel()
  +publikasiGuestSite()
}

class KasusRabies {
  +id : BigInteger
  +id_admin : BigInteger
  +id_jenis_hewan : BigInteger
  +no_surat : String
  +lampiran : String
  +perihal : String
  +nik_pasien : String
  +nama_pasien : String
  +jenis_kelamin_pasien : String
  +umur_pasien : String
  +tgl_lahir_pasien : Date
  +alamat_pasien : String
  +no_hp_pasien : String
  +lokasi_gigitan : String
  +status_var : String
  +ras_hewan : String
  +jenis_kelamin_hewan : String
  +umur_hewan : String
  +nama_pemilik_hewan : String
  +status_hewan : String
  +tgl_kejadian : Date
  +alamat_kejadian : String
  +kronologi : String
  --
  +catatKasusGigitan()
  +cetakSuratLaporan()
}

class ChatMessage {
  +id : BigInteger
  +sender_id : BigInteger
  +receiver_id : BigInteger
  +message : Text
  +attachment : String
  +is_read : Boolean
  +read_at : DateTime
  +created_at : DateTime
  +updated_at : DateTime
  --
  +kirimPesan()
  +bacaPesan()
  +ambilRiwayatChat()
  +hapusPesanSuperAdmin()
}

' Relasi & Multiplicity Sesuai ERD
Role "1" -- "0..*" User : id_role >
Staf "0..1" -- "0..*" User : id_staf >
User "1" -- "0..*" Passkey : user_id >

Pemilik "1" -- "1..*" Hewan : id_pemilik >
JenisHewan "1" -- "0..*" Hewan : id_jenis_hewan >
Hewan "1" -- "0..*" Kunjungan : id_hewan >
User "1" -- "0..*" Kunjungan : id_admin >

Kunjungan "1" -- "0..1" Pemeriksaan : id_kunjungan >
User "1" -- "0..*" Pemeriksaan : id_dokter >
Pemeriksaan "0..*" ..> "0..*" Obat : meresepkan / terapi obat >

User "1" -- "0..*" Inventaris : id_pengelola >
KategoriArtikel "1" -- "0..*" Artikel : id_kategori >
User "1" -- "0..*" Artikel : id_penulis >
Staf "0..1" -- "0..*" Artikel : id_staf >

User "1" -- "0..*" KasusRabies : id_admin >
JenisHewan "1" -- "0..*" KasusRabies : id_jenis_hewan >

User "1" -- "0..*" ChatMessage : sender_id >
User "0..1" -- "0..*" ChatMessage : receiver_id >

note bottom of Hewan
  **Aturan Nomor RM & Autofill:**
  - 1 Hewan memiliki tepat 1 no_rm permanen (RM0001).
  - Kunjungan ulang menggunakan no_rm dan data yang sama melalui Autofill.
end note

note bottom of Pemeriksaan
  **Relasi Rekam Medis:**
  - 1 Kunjungan menghasilkan tepat 1 Pemeriksaan medis (1:1).
  - Dokter mendokumentasikan diagnosa, terapi, dan catatan klinis.
end note

@enduml
