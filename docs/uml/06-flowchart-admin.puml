@startuml 06-flowchart-admin
title Flowchart Alur Kerja Utama - Role Admin

skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundCorner 8

skinparam activity {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #0F172A
    FontSize 11
    DiamondBackgroundColor #FEF08A
    DiamondBorderColor #CA8A04
    DiamondFontColor #713F12
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #EAB308
    FontColor #713F12
    FontSize 10
}

start
:Login ke Aplikasi;
:Menampilkan Dashboard Admin;

if (Pilih Modul Pelayanan?) then (Pendaftaran Pasien & Kunjungan)
    :Cari Data Pemilik dan Hewan\n(Berdasarkan NIK Pemilik atau No. RM);
    if (Apakah data pemilik dan hewan sudah tersedia?) then (Tidak / Pasien Baru)
        :Input Data Pemilik dan Hewan Baru\nserta Simpan ke Database\n(Menetapkan Nomor RM Permanen baru: RM0001);
    else (Ya / Pasien Lama)
        :Sistem Melakukan Autofill Berkelanjutan\n(Data pemilik, identitas hewan, & RM0001 terisi otomatis);
        note right
          Admin tidak perlu mengetik ulang
          data pemilik dan identitas hewan.
        end note
    endif
    :Input Klinis Hari Ini (Berat & Suhu) serta Anamnesa;\nDaftarkan Kunjungan Baru ke Database (visits)\n(Masuk ke Daftar Antrean Admin & Dokter);
    :Kelola Antrean Administrasi;
else (Surveilans Kasus Gigitan Rabies - GHPR)
    :Buka Formulir Pencatatan Kasus Rabies;
    :Input Data Korban Pasien (NIK, Nama, Kontak, Alamat)\ndan Lokasi Gigitan serta Status VAR;
    :Pilih Jenis Hewan Penggigit (animal_types),\nIdentitas Hewan, dan Status Hewan (Observasi/Mati);
    :Simpan Kasus Rabies ke Database (rabies_cases);
    :Cetak Surat Rujukan / Dokumen Laporan Rabies;
endif

:Logout;
stop

@enduml
