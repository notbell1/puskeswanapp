@startuml 14-package-diagram
title Package Diagram - Struktur Arsitektur Paket & Entitas ERD
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam packageStyle rectangle

package "Sistem Informasi Puskeswan (App Layer)" {

  package "App\\Models (Entitas Basis Data Sesuai ERD)" as PKG_MODELS {
    class Role
    class Staff
    class User
    class Passkey
    class Owner
    class AnimalType
    class Animal
    class Visit
    class Examination
    class Medicine
    class Inventory
    class Category
    class Article
    class RabiesCase
    class ChatMessage
  }

  package "App\\Http\\Controllers\\Shared & Chat" as PKG_SHARED {
    class ChatController
  }

  package "App\\Http\\Controllers\\SuperAdmin" as PKG_SUPER_ADMIN {
    class UserController
    class StaffController
    class InventoryController
    class MedicineController
    class ArticleController
    class ReportController
  }

  package "App\\Http\\Controllers\\Admin" as PKG_ADMIN {
    class PatientRegistrationController
    class VisitController
    class RabiesCaseController
    class AutofillService
  }

  package "App\\Http\\Controllers\\Dokter" as PKG_DOKTER {
    class ExaminationController
    class MedicalRecordController
  }

  package "App\\Http\\Middleware & Auth" as PKG_AUTH {
    class AuthenticateSession
    class RoleMiddleware
    class PasskeyService
  }

  package "App\\Http\\Controllers\\Public (Portal Publik)" as PKG_PUBLIC {
    class GuestArticleController
    class GuestStaffController
  }

  package "resources\\js\\Pages (Inertia.js + Vue SPA)" as PKG_FRONTEND {
    class SuperAdminViews
    class AdminViews
    class DoctorViews
    class PublicViews
  }
}

' Ketergantungan Paket terhadap Entitas ERD (Models)
PKG_ADMIN ..> PKG_MODELS : menggunakan Owner, Animal, AnimalType, Visit, RabiesCase
PKG_DOKTER ..> PKG_MODELS : menggunakan Visit, Examination, Medicine
PKG_SUPER_ADMIN ..> PKG_MODELS : mengelola User, Role, Staff, Inventory, Medicine, Category, Article, RabiesCase
PKG_PUBLIC ..> PKG_MODELS : membaca Article, Category, Staff
PKG_AUTH ..> PKG_MODELS : memverifikasi User, Role, Passkey
PKG_SHARED ..> PKG_MODELS : mengelola ChatMessage, User

' Ketergantungan Frontend ke Controller (Inertia SPA)
PKG_FRONTEND ..> PKG_SUPER_ADMIN : Inertia requests / Wayfinder routes
PKG_FRONTEND ..> PKG_ADMIN : Inertia requests / Wayfinder routes
PKG_FRONTEND ..> PKG_DOKTER : Inertia requests / Wayfinder routes
PKG_FRONTEND ..> PKG_SHARED : Floating chat polling & send
PKG_FRONTEND ..> PKG_PUBLIC : Public page visits

' Ketergantungan Alur Antar-Paket
PKG_ADMIN ..> PKG_AUTH : proteksi akses role ADMIN
PKG_DOKTER ..> PKG_AUTH : proteksi akses role DOKTER
PKG_SUPER_ADMIN ..> PKG_AUTH : proteksi akses role SUPER_ADMIN

PKG_DOKTER ..> PKG_ADMIN : mengambil data antrean kunjungan pasien

@enduml
