@startuml 04-use-case-sistem-baru
title Use Case Diagram - Sistem Informasi Puskeswan (Sistem Baru)

left to right direction
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundCorner 8
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 65

skinparam actor {
    BackgroundColor #E2E8F0
    BorderColor #475569
    FontColor #0F172A
    FontSize 11
}

skinparam usecase {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #0F172A
    FontSize 11
    ArrowColor #475569
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #EAB308
    FontColor #713F12
    FontSize 10
}

actor "Super Admin" as SuperAdmin
actor "Admin" as Admin
actor "Dokter" as Dokter

SuperAdmin -[hidden]> Admin
Admin -[hidden]> Dokter

rectangle "Sistem Informasi Puskeswan" {
    usecase "Login & Autentikasi (Password / Passkey)" as UC_Login
    usecase "Logout" as UC_Logout

    usecase "Melihat Dashboard Super Admin" as UC_DashSA
    usecase "Mengelola Akun Pengguna & Keamanan Passkey" as UC_KelolaAkun
    usecase "Mengelola Role & Hak Akses" as UC_KelolaRole
    usecase "Mengelola Master Data Jenis Hewan" as UC_MasterJenis
    usecase "Mengelola Master Data Obat & Vaksin" as UC_MasterObat
    usecase "Mengelola Kategori & Artikel Edukasi" as UC_KelolaArtikel
    usecase "Mengelola Data Tenaga Staf" as UC_KelolaStaf
    usecase "Mengelola Inventaris Peralatan Puskeswan" as UC_KelolaInventaris
    usecase "Melihat Laporan & Cetak PDF Multi-Filter" as UC_LihatLaporan
    usecase "Memantau Aktivitas Sistem" as UC_PantauAktivitas
    usecase "Mengelola Konfigurasi Sistem" as UC_Konfigurasi
    usecase "Melihat Audit dan Log Keamanan" as UC_AuditLog

    usecase "Melihat Dashboard Admin" as UC_DashAdmin
    usecase "Mencari Data & Autofill Berkelanjutan (NIK / No. RM)" as UC_CariData
    usecase "Mengelola Data Pemilik & Hewan Pasien" as UC_KelolaPemilikHewan
    usecase "Mendaftarkan Kunjungan & Klinis Awal" as UC_DaftarKunjungan
    usecase "Mengelola Antrean Administrasi" as UC_AntreanAdmin
    usecase "Melihat Riwayat Rekam Medis" as UC_RiwayatAdmin
    usecase "Mencatat & Mengelola Kasus Gigitan Rabies (GHPR)" as UC_KelolaRabies
    usecase "Mencetak Surat Rujukan / Laporan Kasus Rabies" as UC_CetakRabies

    usecase "Menyampaikan Informasi Pemilik dan Hewan" as UC_Info
    usecase "Mengonfirmasi Data Pasien" as UC_Konfirmasi
    usecase "Mengajukan Pendaftaran melalui Admin" as UC_AjukanDaftar
    usecase "Menghadiri Pemeriksaan Hewan" as UC_HadirPeriksa

    usecase "Melihat Dashboard Dokter" as UC_DashDokter
    usecase "Melihat Daftar Antrean Kunjungan" as UC_AntreanDokter
    usecase "Memilih Kunjungan & Riwayat RM" as UC_PilihKunjungan
    usecase "Melakukan Pemeriksaan Klinis" as UC_Periksa
    usecase "Mencatat Diagnosa, Terapi & Catatan Medis" as UC_CatatMedis
    usecase "Menyimpan Hasil Pemeriksaan" as UC_SimpanPeriksa
    usecase "Menyelesaikan Kunjungan Pasien" as UC_SelesaiKunjungan

    usecase "Menggunakan Chat Internal (1-on-1 & Grup Staf)" as UC_ChatInternal
}

actor "Pasien" as Pasien

note bottom of Pasien
  Pasien tidak memiliki akun, tidak login, dan tidak
  mengakses aplikasi secara langsung. Interaksi
  dilakukan melalui Admin dan Dokter.
end note

SuperAdmin -- UC_Login
SuperAdmin -- UC_DashSA
SuperAdmin -- UC_KelolaAkun
SuperAdmin -- UC_KelolaRole
SuperAdmin -- UC_MasterJenis
SuperAdmin -- UC_MasterObat
SuperAdmin -- UC_KelolaArtikel
SuperAdmin -- UC_KelolaStaf
SuperAdmin -- UC_KelolaInventaris
SuperAdmin -- UC_LihatLaporan
SuperAdmin -- UC_PantauAktivitas
SuperAdmin -- UC_Konfigurasi
SuperAdmin -- UC_AuditLog
SuperAdmin -- UC_ChatInternal
SuperAdmin -- UC_Logout

Admin -- UC_Login
Admin -- UC_DashAdmin
Admin -- UC_CariData
Admin -- UC_KelolaPemilikHewan
Admin -- UC_DaftarKunjungan
Admin -- UC_AntreanAdmin
Admin -- UC_RiwayatAdmin
Admin -- UC_KelolaRabies
Admin -- UC_CetakRabies
Admin -- UC_ChatInternal
Admin -- UC_Info
Admin -- UC_Konfirmasi
Admin -- UC_AjukanDaftar
Admin -- UC_Logout

Dokter -- UC_Login
Dokter -- UC_DashDokter
Dokter -- UC_AntreanDokter
Dokter -- UC_PilihKunjungan
Dokter -- UC_Periksa
Dokter -- UC_CatatMedis
Dokter -- UC_SimpanPeriksa
Dokter -- UC_SelesaiKunjungan
Dokter -- UC_ChatInternal
Dokter -- UC_HadirPeriksa
Dokter -- UC_Logout

UC_Info -- Pasien
UC_Konfirmasi -- Pasien
UC_AjukanDaftar -- Pasien
UC_HadirPeriksa -- Pasien

@enduml
