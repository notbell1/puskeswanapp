@startuml 05-activity-diagram
title Activity Diagram - Proses Pelayanan Sistem Informasi Puskeswan

skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundCorner 8
skinparam swimlaneWidth same
skinparam swimlaneTitleFontStyle bold

skinparam activity {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #0F172A
    FontSize 11
    DiamondBackgroundColor #FEF08A
    DiamondBorderColor #CA8A04
    DiamondFontColor #713F12
}

|#F1F5F9|Pasien|
|#E2E8F0|Admin|
|#DBEAFE|Sistem|
|#E0E7FF|Dokter|

|Pasien|
start
:Datang membawa hewan;
:Menyampaikan informasi pemilik\ndan hewan kepada Admin;

|Admin|
:Mencari data pemilik atau hewan\n(berdasarkan NIK / Nomor RM);

|Sistem|
:Mencari data di database dan\nmenampilkan hasil pencarian;

|Admin|
if (Data sudah terdaftar?) then (Belum Terdaftar / Baru)
    :Menginput data pemilik dan hewan baru\n(memilih jenis hewan via dropdown);
    |Sistem|
    :Menyimpan data baru ke database dan\nmenetapkan nomor RM permanen (RM0001);
else (Sudah Terdaftar / Kunjungan Ulang)
    |Admin|
    :Sistem melakukan Autofill berkelanjutan\n(Data pemilik, hewan, & RM0001 terisi otomatis);
endif

|Admin|
:Menginput data klinis harian\n(Berat badan, suhu tubuh, & anamnesa);
:Mendaftarkan kunjungan baru;

|Sistem|
:Menyimpan kunjungan baru ke database\ndan memasukkannya ke antrean Dokter;

|Dokter|
:Memilih kunjungan dari daftar antrean;

|Sistem|
:Menampilkan data hewan dan riwayat rekam medis\ndari database;

|Dokter|
:Melakukan pemeriksaan klinis hewan;
:Menginput Diagnosa, Terapi Pengobatan, & Catatan Klinis;

|Sistem|
:Menyimpan hasil pemeriksaan ke database (tabel examinations)\ndan memperbarui status kunjungan menjadi selesai (status_antrean);

stop
@enduml
