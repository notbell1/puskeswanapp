@startuml 08-flowchart-super-admin
title Flowchart Alur Kerja Utama - Role Super Admin

skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundCorner 8

skinparam activity {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #0F172A
    FontSize 11
    DiamondBackgroundColor #FEF08A
    DiamondBorderColor #CA8A04
    DiamondFontColor #713F12
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #EAB308
    FontColor #713F12
    FontSize 10
}

start
:Login ke Aplikasi;
:Menampilkan Dashboard Super Admin\n(Statistik kunjungan harian / bulanan / tahunan);
:Pilih Modul Pengelolaan Sistem;
:Kelola Data Sistem Sesuai Modul:\n- Akun Pengguna, Role & Keamanan Passkey (users, roles, passkeys)\n- Master Data (animal_types & medicines)\n- Kategori & Artikel Edukasi (categories, articles) serta Data Staf (staff)\n- Inventaris Peralatan Puskeswan (inventories);
:Akses Laporan & Cetak PDF Multi-Filter\n(Rekap Kunjungan/Rekam Medis & Surveilans Kasus Rabies);
:Pantau Konfigurasi Sistem, Aktivitas, dan Audit Log;
:Logout;
stop

@enduml
