@startuml 10-erd
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #F9F9F9
skinparam classBorderColor #4A5568

title ERD Sistem Informasi UPT. Puskeswan Kota Pariaman

entity "roles" {
  + id : bigint [PK]
  --
  nama_role : varchar(255)
  deskripsi : text
  created_at : timestamp
  updated_at : timestamp
}

entity "staff" {
  + id : bigint [PK]
  --
  nama_staf : varchar(255)
  jabatan : varchar(255)
  nip_strv : varchar(255)
  foto : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "users" {
  + id : bigint [PK]
  --
  # id_role : bigint [FK]
  # id_staf : bigint [FK, Nullable]
  name : varchar(255)
  email : varchar(255)
  email_verified_at : timestamp
  password : varchar(255)
  two_factor_secret : text
  two_factor_recovery_codes : text
  two_factor_confirmed_at : timestamp
  foto : varchar(255)
  status_aktif : tinyint(1)
  remember_token : varchar(100)
  created_at : timestamp
  updated_at : timestamp
}

entity "owners" {
  + id : bigint [PK]
  --
  nik : varchar(20)
  nama_lengkap : varchar(255)
  no_hp_wa : varchar(20)
  alamat_lengkap : text
  created_at : timestamp
  updated_at : timestamp
}

entity "animal_types" {
  + id : bigint [PK]
  --
  nama_jenis : varchar(255)
  keterangan : text
  created_at : timestamp
  updated_at : timestamp
}

entity "animals" {
  + id : bigint [PK]
  --
  # id_pemilik : bigint [FK]
  # id_jenis_hewan : bigint [FK]
  no_rm : varchar(20)
  nama_hewan : varchar(255)
  jenis_kelamin : varchar(20)
  umur : varchar(255)
  warna_hewan : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "visits" {
  + id : bigint [PK]
  --
  # id_hewan : bigint [FK]
  # id_admin : bigint [FK]
  tgl_kunjungan : datetime
  berat_badan : decimal(5,2)
  suhu_tubuh : decimal(4,2)
  anamnesa : text
  status_antrean : varchar(30)
  created_at : timestamp
  updated_at : timestamp
}

entity "examinations" {
  + id : bigint [PK]
  --
  # id_kunjungan : bigint [FK]
  # id_dokter : bigint [FK]
  waktu_selesai : datetime
  diagnosa : text
  terapi_pengobatan : text
  catatan : text
  created_at : timestamp
  updated_at : timestamp
}

entity "inventories" {
  + id : bigint [PK]
  --
  # id_pengelola : bigint [FK]
  kode_barang : varchar(255)
  nama_barang : varchar(255)
  kategori : varchar(255)
  jumlah : int
  kondisi : varchar(255)
  keterangan : text
  created_at : timestamp
  updated_at : timestamp
}

entity "medicines" {
  + id : bigint [PK]
  --
  kode_obat : varchar(255)
  nama_obat : varchar(255)
  stok : int
  satuan : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "categories" {
  + id : bigint [PK]
  --
  nama_kategori : varchar(255)
  slug : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "articles" {
  + id : bigint [PK]
  --
  # id_penulis : bigint [FK]
  # id_kategori : bigint [FK]
  # id_staf : bigint [FK, Nullable]
  judul : varchar(255)
  slug : varchar(255)
  author_name : varchar(255)
  ringkasan : text
  isi_berita : longtext
  gambar : varchar(255)
  tgl_terbit : date
  status : varchar(20)
  created_at : timestamp
  updated_at : timestamp
}

entity "passkeys" {
  + id : bigint [PK]
  --
  # user_id : bigint [FK]
  name : varchar(255)
  credential_id : varchar(255)
  credential : json
  last_used_at : timestamp
  created_at : timestamp
  updated_at : timestamp
}

entity "rabies_cases" {
  + id : bigint [PK]
  --
  # id_admin : bigint [FK]
  # id_jenis_hewan : bigint [FK]
  no_surat : varchar(255)
  lampiran : varchar(255)
  perihal : varchar(255)
  nik_pasien : varchar(20)
  nama_pasien : varchar(255)
  jenis_kelamin_pasien : varchar(20)
  umur_pasien : varchar(50)
  tgl_lahir_pasien : date
  alamat_pasien : text
  no_hp_pasien : varchar(20)
  lokasi_gigitan : varchar(255)
  status_var : varchar(50)
  ras_hewan : varchar(100)
  jenis_kelamin_hewan : varchar(20)
  umur_hewan : varchar(50)
  nama_pemilik_hewan : varchar(255)
  status_hewan : varchar(50)
  tgl_kejadian : date
  alamat_kejadian : text
  kronologi : text
  created_at : timestamp
  updated_at : timestamp
}

entity "chat_messages" {
  + id : bigint [PK]
  --
  # sender_id : bigint [FK]
  # receiver_id : bigint [FK, Nullable]
  message : text
  attachment : varchar(255)
  is_read : tinyint(1)
  read_at : timestamp
  created_at : timestamp
  updated_at : timestamp
}

' Relasi Antar Tabel (Foreign Key Constraints)
roles ||--o{ users : "id_role"
staff ||--o{ users : "id_staf (ON DELETE SET NULL)"
owners ||--o{ animals : "id_pemilik (ON DELETE RESTRICT)"
animal_types ||--o{ animals : "id_jenis_hewan (ON DELETE RESTRICT)"
animal_types ||--o{ rabies_cases : "id_jenis_hewan (ON DELETE RESTRICT)"
animals ||--o{ visits : "id_hewan (ON DELETE RESTRICT)"
users ||--o{ visits : "id_admin (ON DELETE RESTRICT)"
visits ||--o{ examinations : "id_kunjungan (ON DELETE CASCADE)"
users ||--o{ examinations : "id_dokter (ON DELETE RESTRICT)"
users ||--o{ inventories : "id_pengelola (ON DELETE RESTRICT)"
categories ||--o{ articles : "id_kategori (ON DELETE RESTRICT)"
users ||--o{ articles : "id_penulis (ON DELETE RESTRICT)"
staff ||--o{ articles : "id_staf (ON DELETE SET NULL)"
users ||--o{ passkeys : "user_id (ON DELETE CASCADE)"
users ||--o{ rabies_cases : "id_admin (ON DELETE RESTRICT)"
users ||--o{ chat_messages : "sender_id (ON DELETE CASCADE)"
users ||--o{ chat_messages : "receiver_id (ON DELETE CASCADE)"

@enduml
